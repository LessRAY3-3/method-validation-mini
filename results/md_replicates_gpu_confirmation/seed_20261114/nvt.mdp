tau_t = 0.1 0.1
ref_t = 300 300
pcoupl = no
gen_vel = yes
gen_temp = 300
gen_seed = 20261114
ld-seed = 20261114
nstxout-compressed = 5000
nstenergy = 500
nstlog = 500
